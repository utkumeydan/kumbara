# Bu dosyayı .env olarak kopyala. Hiçbiri zorunlu değil: boş bırakırsan yerelde
# http://localhost:8080 adresinde çalışır. İnternete açmadan önce ilk iki satırı mutlaka değiştir.

# Veritabanı şifresi (uzun ve rastgele bir değer kullan)
POSTGRES_PASSWORD=
# Uygulamanın kullanıcılara görünen adresi, ör. https://kumbara.example.com
APP_URL=
# Web uygulamasının yayınlanacağı port
WEB_PORT=8080
APP_TZ=Europe/Istanbul

# İsteğe bağlı: web uygulaması API'yi başka bir adresten çağıracaksa (boşsa kendi adresinden /api)
EXPO_PUBLIC_API_URL=
# İsteğe bağlı: web dışında ayrı bir adresten çağıran istemciler (virgülle ayrılmış)
CORS_ORIGINS=

# İsteğe bağlı: şifre sıfırlama e-postaları
SMTP_URL=
MAIL_FROM=Kumbara <no-reply@example.com>

# İsteğe bağlı: Apple / Google ile giriş
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# İsteğe bağlı: Kumbara+ (RevenueCat webhook'u)
RC_WEBHOOK_SECRET=

# İsteğe bağlı: push bildirimleri ve hata takibi
EXPO_ACCESS_TOKEN=
SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=

# İsteğe bağlı: gece yedeği zamanlaması (cron ya da @daily)
BACKUP_SCHEDULE=@daily

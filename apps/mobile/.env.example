# API adresi (yerelde API varsayılan olarak 3000 portunda çalışır)
EXPO_PUBLIC_API_URL=http://localhost:3000

# İsteğe bağlı: Google ile giriş (Google Cloud Console > OAuth istemci kimlikleri)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# İsteğe bağlı: Kumbara+ satın alma (RevenueCat > API keys)
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=

# İsteğe bağlı: hata takibi (Sentry)
EXPO_PUBLIC_SENTRY_DSN=
